
% Gemini Theme - VSU Research Poster
% Custom Valdosta State University Colors

% ==========================================
% COLOR DEFINITIONS
% ==========================================

% Primary Colors
\definecolor{VSUBlack}{RGB}{20,20,20}
\definecolor{VSURed}{RGB}{218,26,50}
\definecolor{VSUWhite}{RGB}{255,255,255}
\definecolor{VSULightGray}{RGB}{245,245,245}
\definecolor{VSUDarkGray}{RGB}{80,80,80}

% Secondary Colors
\definecolor{flame}{RGB}{248,164,41}
\definecolor{sky}{RGB}{193,102,34}
\definecolor{stone}{RGB}{143,57,49}
\definecolor{lake}{RGB}{145,171,90}
\definecolor{pine}{RGB}{88,89,63}

% ==========================================
% BASIC COLORS
% ==========================================

\setbeamercolor{normal text}{
    fg=VSUBlack,
    bg=VSUWhite
}

\setbeamercolor{palette primary}{
    fg=VSUBlack,
    bg=VSUWhite
}

\setbeamercolor{palette secondary}{
    fg=VSUBlack,
    bg=VSUWhite
}

\setbeamercolor{palette tertiary}{
    fg=VSUWhite,
    bg=VSUBlack
}

\setbeamercolor{palette quaternary}{
    fg=VSUBlack,
    bg=VSUWhite
}

\setbeamercolor{structure}{
    fg=VSURed
}

% ==========================================
% MAIN HEADLINE
% Black background / White lettering
% ==========================================

\setbeamercolor{headline}{
    fg=VSUWhite,
    bg=VSUBlack
}

\setbeamercolor{headline rule}{
    bg=VSURed
}

% ==========================================
% REGULAR SECTION HEADERS
% Red titles / White backgrounds
% ==========================================

\setbeamercolor{block title}{
    fg=VSURed,
    bg=VSUWhite
}

\setbeamercolor{block separator}{
    bg=VSURed
}

\setbeamercolor{block body}{
    fg=VSUBlack,
    bg=VSUWhite
}

% ==========================================
% ALERT BLOCKS
% Red header / White lettering
% Light-gray body
% ==========================================

\setbeamercolor{block alerted title}{
    fg=VSULightGray,
    bg=VSURed
}

\setbeamercolor{block alerted separator}{
    bg=VSURed
}

\setbeamercolor{block alerted body}{
    fg=VSUBlack,
    bg=VSULightGray
}

% ==========================================
% EXAMPLE BLOCKS
% ==========================================

\setbeamercolor{block example title}{
    fg=VSUWhite,
    bg=VSUBlack
}

\setbeamercolor{block example body}{
    fg=VSUBlack,
    bg=VSULightGray
}

% ==========================================
% HEADINGS
% ==========================================

\setbeamercolor{heading}{
    fg=VSURed
}

% ==========================================
% BULLET POINTS
% ==========================================

\setbeamercolor{item}{
    fg=VSURed
}

% ==========================================
% BIBLIOGRAPHY
% ==========================================

\setbeamercolor{bibliography item}{
    fg=VSUBlack
}

\setbeamercolor{bibliography entry author}{
    fg=VSUBlack
}

\setbeamercolor{bibliography entry title}{
    fg=VSUBlack
}

\setbeamercolor{bibliography entry location}{
    fg=VSUBlack
}

\setbeamercolor{bibliography entry note}{
    fg=VSUBlack
}

\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}
